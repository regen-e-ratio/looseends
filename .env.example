# ---- Required ----
# Postgres connection string (set automatically when you connect Neon through Vercel → Storage)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afterword
# Any long random string (32+ chars). Encrypts vault contents. NEVER change or lose it after launch.
ENCRYPTION_KEY=
# Any long random string. Vercel sends it to /api/cron/check-switches so only Vercel can run the job.
CRON_SECRET=

# ---- Email (pick one; if none is set, emails are printed to the server log — dev only) ----
# Option A (recommended): Resend
RESEND_API_KEY=
# Option B: any SMTP server (e.g. Gmail with an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Afterword <hello@yourdomain.com>". Must be on a domain verified in Resend (or your SMTP address).
EMAIL_FROM=

# ---- Optional ----
# Public URL of the app. On Vercel this falls back to the production domain automatically.
APP_URL=http://localhost:3000
APP_NAME=Afterword
